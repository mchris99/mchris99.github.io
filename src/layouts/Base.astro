---
import '@fontsource-variable/big-shoulders-stencil/opsz.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
}
const about = await getEntry('pages', 'about');
const name = about?.data.name ?? 'Chris McHenry';
const headline = about?.data.headline ?? '';
const { title, description = `${name}. ${headline}` } = Astro.props;
const fullTitle = title ? `${title} | ${name}` : `${name} | ${headline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/tags/', label: 'Tags' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#131518" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav wrap">
      <a href="/" class="logo" aria-current={path === '/' ? 'page' : undefined}>{name}</a>
      <nav aria-label="Main">
        {
          links.map((l) => (
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
        {
          about?.data.resume && (
            <a href={about.data.resume} download>
              Resume
            </a>
          )
        }
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot-inner">
        <div>
          <p class="foot-title">Say hello</p>
          <a class="foot-mail" href={`mailto:${about?.data.email}`}>{about?.data.email}</a>
        </div>
        <div class="foot-links">
          {about?.data.github && <a href={about.data.github}>GitHub</a>}
          {about?.data.linkedin && <a href={about.data.linkedin}>LinkedIn</a>}
          {about?.data.resume && <a href={about.data.resume} download>Resume (PDF)</a>}
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/interactions.ts';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: var(--score);
    color: #0d1020;
    padding: 0.5rem 1rem;
    z-index: 300;
  }
  .skip:focus {
    left: 0.5rem;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 0;
  }
  .logo {
    font-family: var(--stencil);
    font-weight: 800;
    font-size: 1.7rem;
    text-decoration: none;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .logo:hover {
    color: var(--cut);
  }
  nav {
    display: flex;
    gap: 1.4rem;
  }
  nav a {
    font-weight: 600;
    font-variation-settings: 'wdth' 110;
    text-decoration: none;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    border-bottom-color: var(--cut);
  }
  nav a[aria-current='page'] {
    border-bottom: 2px dashed var(--cut);
  }
  @media (max-width: 520px) {
    .logo {
      font-size: 1.35rem;
    }
    nav {
      gap: 0.9rem;
    }
  }
  .foot {
    margin-top: 7rem;
    background: #0c0d0f;
    color: var(--ink);
    border-top: 1px solid var(--line);
    padding: 4rem 0 4.5rem;
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    align-items: end;
    flex-wrap: wrap;
    gap: 2rem;
  }
  .foot-title {
    font-family: var(--stencil);
    font-weight: 800;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 0.9;
    margin: 0 0 0.6rem;
    color: var(--ply);
  }
  .foot-mail {
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    font-weight: 600;
    text-decoration-color: var(--cut);
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  .foot-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .foot-links a {
    text-decoration: none;
    font-weight: 600;
    border-bottom: 2px solid var(--ply-dark);
  }
  .foot-links a:hover {
    color: var(--ply);
    border-color: var(--cut);
  }
</style>
