---
import Cover from './Cover.astro';
import { categoryColor, STATUS_LABEL, formatDate, type Project } from '../lib/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, category, tags, status, date } = project.data;
---

<article class="row" data-cutline>
  <a href={`/projects/${project.id}/`} class="thumb" tabindex="-1" aria-hidden="true">
    <Cover project={project} />
  </a>
  <div class="text">
    <p class="meta">
      <span class="swatch" style={`background:${categoryColor(category)}`}></span>
      {category}, {formatDate(date)}, {STATUS_LABEL[status].toLowerCase()}
    </p>
    <h3><a href={`/projects/${project.id}/`}>{title}</a></h3>
    <p class="sum">{summary}</p>
    <div class="tags">
      {tags.map((t) => <a class="tag" href={`/tags/${t}/`}>{t}</a>)}
    </div>
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: minmax(0, 260px) 1fr;
    gap: 1.8rem;
    align-items: center;
    padding: 1.1rem;
    margin: 0 -1.1rem;
    border-radius: 8px;
  }
  .thumb {
    display: block;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.5rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .swatch {
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--ink);
    flex: none;
  }
  h3 {
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    margin-bottom: 0.4rem;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .sum {
    margin: 0 0 0.9rem;
    max-width: 52ch;
  }
  .tags {
    position: relative;
    z-index: 1;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .thumb :global(.cover) {
      aspect-ratio: 16 / 7;
    }
  }
</style>
