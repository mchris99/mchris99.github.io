---
import { Image } from 'astro:assets';
import { categoryColor, type Project } from '../lib/projects';

interface Props {
  project: Project;
  size?: 'thumb' | 'hero';
}
const { project, size = 'thumb' } = Astro.props;
const { title, category, cover } = project.data;
const color = categoryColor(category);
---

<div class={`cover ${size} ${cover ? '' : 'ply'}`} style={`--layer:${color}`}>
  {
    cover ? (
      <Image src={cover} alt="" widths={[400, 800, 1600]} sizes={size === 'hero' ? '100vw' : '320px'} />
    ) : (
      <span class="engraved" aria-hidden="true">
        {title}
      </span>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 6px;
    aspect-ratio: 4 / 3;
  }
  .cover.hero {
    aspect-ratio: 21 / 8;
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1.5px solid var(--layer);
    border-radius: 3px;
    pointer-events: none;
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .engraved {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1rem 1.1rem;
    font-family: var(--stencil);
    font-weight: 800;
    font-size: 2.1rem;
    line-height: 0.88;
    color: rgb(60 35 15 / 0.82);
    text-shadow: 0 1px 0 rgb(255 240 210 / 0.5);
  }
  .hero .engraved {
    font-size: clamp(3rem, 10vw, 8rem);
    padding: 1.6rem 2rem;
  }
</style>
