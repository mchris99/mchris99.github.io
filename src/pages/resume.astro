---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';

const about = (await getEntry('pages', 'about'))!;
const pdf = about.data.resume ?? '/resume.pdf';
const fileName = `${about.data.name.replace(/\s+/g, '-')}-Resume.pdf`;
---

<Base title="Resume" description={`Resume of ${about.data.name}.`}>
  <section class="wrap">
    <div class="head">
      <h1>Resume</h1>
      <div class="actions">
        <a class="btn primary" href={pdf} download={fileName} data-magnetic>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16"></path>
          </svg>
          Download PDF
        </a>
        <a class="btn" href={pdf} target="_blank" rel="noopener" data-magnetic>Open in a new tab</a>
      </div>
    </div>

    <div class="pages" id="pages" data-src={pdf}>
      <div class="sheet placeholder">
        <p>Loading resume</p>
        <noscript><a href={pdf}>Open the resume PDF</a></noscript>
      </div>
    </div>
  </section>
</Base>

<script>
  import * as pdfjs from 'pdfjs-dist';
  import workerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import 'pdfjs-dist/web/pdf_viewer.css';

  pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;

  const host = document.getElementById('pages')!;
  const src = host.dataset.src!;

  async function draw(doc: any) {
    const frag = document.createDocumentFragment();
    const width = Math.min(host.clientWidth - 32, 880); // room for the dashed cut line
    const dpr = Math.min(window.devicePixelRatio || 1, 3);

    for (let n = 1; n <= doc.numPages; n++) {
      const page = await doc.getPage(n);
      const base = page.getViewport({ scale: 1 });
      const scale = width / base.width;
      const viewport = page.getViewport({ scale });

      const sheet = document.createElement('div');
      sheet.className = 'sheet';
      sheet.style.width = `${viewport.width}px`;
      sheet.style.height = `${viewport.height}px`;
      sheet.style.setProperty('--scale-factor', String(scale));

      const canvas = document.createElement('canvas');
      canvas.width = Math.floor(viewport.width * dpr);
      canvas.height = Math.floor(viewport.height * dpr);
      canvas.setAttribute('aria-hidden', 'true');
      sheet.appendChild(canvas);
      await page.render({
        canvas,
        canvasContext: canvas.getContext('2d')!,
        viewport,
        transform: dpr !== 1 ? [dpr, 0, 0, dpr, 0, 0] : undefined,
      }).promise;

      // Selectable, screen-reader-friendly text on top of the picture of the page.
      const text = document.createElement('div');
      text.className = 'textLayer';
      sheet.appendChild(text);
      await new pdfjs.TextLayer({
        textContentSource: page.streamTextContent(),
        container: text,
        viewport,
      }).render();

      // Keep the PDF's links (email, LinkedIn, GitHub) clickable.
      const notes = await page.getAnnotations();
      for (const a of notes) {
        if (a.subtype !== 'Link' || !a.url) continue;
        const [x1, y1, x2, y2] = viewport.convertToViewportRectangle(a.rect);
        const link = document.createElement('a');
        link.href = a.url;
        link.target = '_blank';
        link.rel = 'noopener';
        link.className = 'pdf-link';
        link.setAttribute('aria-label', a.url.replace(/^mailto:/, ''));
        Object.assign(link.style, {
          left: `${Math.min(x1, x2)}px`,
          top: `${Math.min(y1, y2)}px`,
          width: `${Math.abs(x2 - x1)}px`,
          height: `${Math.abs(y2 - y1)}px`,
        });
        sheet.appendChild(link);
      }
      frag.appendChild(sheet);
    }
    host.replaceChildren(frag);
  }

  pdfjs
    .getDocument({ url: src })
    .promise.then(async (doc) => {
      await draw(doc);
      let last = host.clientWidth;
      let t: number | undefined;
      new ResizeObserver(() => {
        if (Math.abs(host.clientWidth - last) < 8) return;
        last = host.clientWidth;
        clearTimeout(t);
        t = window.setTimeout(() => draw(doc), 150);
      }).observe(host);
    })
    .catch((err) => {
      console.error(err);
      host.innerHTML = `<div class="sheet placeholder"><p>The resume couldn't be displayed here. <a href="${src}">Open the PDF</a> instead.</p></div>`;
    });
</script>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin: 2rem 0 3rem;
  }
  h1 {
    font-size: clamp(4rem, 13vw, 9rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 0.6rem;
  }
  .pages {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    padding: 0 0.5rem;
  }
</style>

<style is:global>
  /* A sheet of paper resting on the laser bed, with the red cut path around it. */
  .pages .sheet {
    position: relative;
    max-width: 880px;
    background: #fff;
    border-radius: 2px;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.4),
      0 24px 50px -20px rgb(0 0 0 / 0.8);
    outline: 1.5px dashed var(--cut);
    outline-offset: 12px;
  }
  .pages .sheet canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .pages .sheet.placeholder {
    width: min(100%, 880px);
    aspect-ratio: 8.5 / 11;
    display: grid;
    place-items: center;
    color: #5a4a3c;
    font-size: 1.1rem;
  }
  .pages .sheet.placeholder a {
    color: #2b59f5;
  }
  .pages .textLayer ::selection {
    background: rgb(229 48 42 / 0.3);
  }
  .pages .pdf-link {
    position: absolute;
    z-index: 3;
    border-radius: 2px;
  }
  .pages .pdf-link:hover {
    background: rgb(43 89 245 / 0.12);
  }
  .pages .pdf-link:focus-visible {
    outline: 2px solid var(--score);
  }
</style>
