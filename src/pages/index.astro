---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getEntry, render } from 'astro:content';
import { getProjects } from '../lib/projects';

const about = (await getEntry('pages', 'about'))!;
const { Content } = await render(about);
const { name, headline, location, email, github, linkedin, resume, skills } = about.data;

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const shown = (featured.length ? featured : projects).slice(0, 6);
---

<Base>
  <section class="wrap">
    <div class="sheet ply">
      <div class="stage">
        <canvas id="laser" role="img" aria-label={name}></canvas>
        <h1 class="sr">{name}</h1>
      </div>
      <div class="band">
        <p class="headline">{headline}</p>
        <div class="ctas">
          {
            resume && (
              <a class="btn primary" href={resume} download data-magnetic>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16" />
                </svg>
                Download resume
              </a>
            )
          }
          <a class="btn" href={`mailto:${email}`} data-magnetic>Email me</a>
          {github && <a class="btn" href={github} data-magnetic>GitHub</a>}
          {linkedin && <a class="btn" href={linkedin} data-magnetic>LinkedIn</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="wrap about">
    <div class="prose"><Content /></div>
    {
      skills.length > 0 && (
        <aside class="skills">
          <h2>Tools</h2>
          <ul>
            {skills.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </aside>
      )
    }
  </section>

  <section class="wrap work">
    <div class="work-head">
      <h2>Projects</h2>
      <a href="/projects/" class="all">See all {projects.length} in the project tree</a>
    </div>
    <div class="list">
      {shown.map((p) => <ProjectRow project={p} />)}
    </div>
  </section>
</Base>

<script>
  import { startLaser } from '../scripts/laser.ts';
  const c = document.getElementById('laser') as HTMLCanvasElement | null;
  const label = c?.getAttribute('aria-label') ?? '';
  const parts = label.trim().split(/\s+/);
  const lines = (parts.length > 1 ? [parts[0], parts.slice(1).join(' ')] : parts).map((s) => s.toUpperCase());
  if (c) startLaser(c, lines);
</script>

<style>
  .sheet {
    position: relative;
    border-radius: 14px;
    border: 2px solid var(--ink);
    box-shadow:
      0 1px 0 var(--ply-dark),
      0 2px 0 var(--ink),
      0 18px 40px -22px rgb(26 18 12 / 0.55);
    overflow: hidden;
  }
  /* the sheet's own cut outline, inset like a part on a plywood blank */
  .sheet::before {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1.5px dashed var(--cut);
    border-radius: 8px;
    pointer-events: none;
  }
  .stage {
    position: relative;
    height: clamp(190px, 46vw, 560px);
    cursor: crosshair;
    touch-action: pan-y;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem 2rem;
    padding: 0 clamp(1.4rem, 3vw, 2.4rem) clamp(1.6rem, 3vw, 2.4rem);
  }
  .headline {
    margin: 0;
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    font-weight: 750;
    font-variation-settings: 'wdth' 125;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem 5rem;
    margin-top: 5rem;
    align-items: start;
  }
  .about .prose {
    font-size: clamp(1.2rem, 1.8vw, 1.4rem);
  }
  .skills h2 {
    font-size: 2.4rem;
    margin-bottom: 0.8rem;
  }
  .skills ul {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .skills li {
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--ink-soft);
    font-weight: 600;
  }
  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  .work {
    margin-top: 6rem;
  }
  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }
  .all {
    font-weight: 700;
    text-decoration-color: var(--cut);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .all:hover {
    color: var(--cut);
  }
  .list {
    display: grid;
    gap: 1.2rem;
  }
</style>
