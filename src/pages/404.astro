---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap">
    <h1>404</h1>
    <p>This page isn't on the sheet. It may have moved, or the link has a typo.</p>
    <p><a class="btn" href="/projects/">Browse all projects</a></p>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(6rem, 25vw, 16rem);
    color: transparent;
    -webkit-text-stroke: 2px var(--cut);
    margin-top: 2rem;
  }
  p {
    font-size: 1.3rem;
  }
</style>
